{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lineuppro",
  "main": "worker.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 0 * * *", "0 12 * * *"]
  }
}
